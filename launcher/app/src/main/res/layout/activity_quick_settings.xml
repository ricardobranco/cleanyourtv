<?xml version="1.0" encoding="utf-8"?>
<!-- Quick settings opened by the remote's Settings button, laid out like Google TV's panel: a glass column on the
     right with the date and time, a gear for the TV's settings, two columns of tiles and the notifications. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/panel"
        android:layout_width="330dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="18dp"
        android:background="@drawable/glass_panel"
        android:elevation="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/font_body"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp" />

                    <TextClock
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/font_medium"
                        android:textColor="#FFFFFFFF"
                        android:textSize="30sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/gear"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/quick_tile_bg"
                    android:clickable="true"
                    android:contentDescription="@string/tv_settings"
                    android:focusable="true"
                    android:padding="11dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@drawable/pill_text" />
            </LinearLayout>

            <!-- Now playing: shown only while an app has a media session with something in it. -->
            <LinearLayout
                android:id="@+id/now_playing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/media_card_bg"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/media_open"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/media_row_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/media_art"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/media_art_bg"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/media_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="@string/font_medium"
                            android:maxLines="2"
                            android:textColor="@drawable/pill_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/media_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="@string/font_medium"
                            android:singleLine="true"
                            android:textColor="@drawable/pill_text_mid"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/media_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:max="1000"
                    android:progressBackgroundTint="#33FFFFFF"
                    android:progressTint="#FFFFFFFF"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/media_previous"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/media_button_bg"
                        android:clickable="true"
                        android:contentDescription="@string/media_previous"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_media_previous"
                        android:tint="@drawable/pill_text" />

                    <ImageView
                        android:id="@+id/media_play_pause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/media_button_bg"
                        android:clickable="true"
                        android:contentDescription="@string/media_play"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_media_play"
                        android:tint="@drawable/pill_text" />

                    <ImageView
                        android:id="@+id/media_next"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/media_button_bg"
                        android:clickable="true"
                        android:contentDescription="@string/media_next"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_media_next"
                        android:tint="@drawable/pill_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@string/font_medium"
                android:text="@string/quick_notifications"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
